@baseUrl = http://localhost:3000
# Mesmo valor da variável de ambiente ADMIN_TOKEN usada ao subir a aplicação.
@adminToken = troque-pelo-valor-de-ADMIN_TOKEN

### Checkout - sucesso (e-mail novo: cria a conta com a senha informada)
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - conta já cadastrada (exige a senha da conta em "pwd")
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Leonan",
  "eml": "leonan@fullcycle.com.br",
  "pwd": "123",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Relatório financeiro administrativo
GET {{baseUrl}}/api/admin/financial-report
X-Admin-Token: {{adminToken}}

### Deletar usuário
DELETE {{baseUrl}}/api/users/1
X-Admin-Token: {{adminToken}}
