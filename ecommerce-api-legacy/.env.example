# Variáveis lidas do ambiente do processo (a aplicação não carrega arquivo .env).
# Defina-as no shell antes de `npm start`. Variável vazia vale como ausente.

# Porta HTTP (padrão: 3000)
PORT=3000

# Interface de rede (padrão: 127.0.0.1; use 0.0.0.0 para aceitar conexões externas)
HOST=127.0.0.1

# ':memory:' (padrão) ou caminho de arquivo SQLite relativo à raiz do projeto
DATABASE_PATH=:memory:

# Popula cursos e usuário de exemplo quando o banco está vazio (padrão: true)
SEED_ON_START=true

# Token exigido no header X-Admin-Token das rotas /api/admin/*.
# Sem valor, as rotas administrativas respondem 401.
ADMIN_TOKEN=
