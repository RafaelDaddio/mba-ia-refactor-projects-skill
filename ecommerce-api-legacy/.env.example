# Variáveis lidas do ambiente do processo (process.env). O projeto não carrega
# arquivos .env: defina-as no shell ou no serviço que executa `npm start`.
# Variável vazia vale como ausente.

# Porta e interface de escuta (padrões: 3000 e 127.0.0.1).
PORT=
HOST=

# Banco SQLite. Padrão: :memory: (recriado a cada boot). Um caminho relativo
# é resolvido a partir da raiz do projeto.
DATABASE_PATH=

# Carrega os dados de exemplo quando o banco está vazio (padrão: true).
SEED_ON_START=

# Token das rotas administrativas, enviado no header X-Admin-Token.
# Sem ele, o relatório financeiro e a exclusão de usuários respondem 401.
ADMIN_TOKEN=

# Chave do gateway de pagamento. Sem ela, a integração fica desabilitada e a
# aprovação segue a regra simulada do projeto. Nunca é gravada em log.
PAYMENT_GATEWAY_KEY=
