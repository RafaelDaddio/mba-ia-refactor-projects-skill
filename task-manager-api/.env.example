# Variáveis lidas do ambiente do processo (o projeto não carrega arquivo .env).
# Variável vazia vale como ausente e usa o padrão indicado.

# Servidor — padrões: host 127.0.0.1, porta 5000, debug desligado
APP_HOST=
APP_PORT=
APP_DEBUG=

# Banco — padrão: sqlite:///tasks.db (arquivo em instance/tasks.db)
DATABASE_URL=

# Segredo do Flask — sem padrão; se ausente, uma chave aleatória é gerada a cada boot
SECRET_KEY=

# Token exigido no header X-Admin-Token para atribuir papel diferente de "user"
# (POST /users e PUT /users/<id>). Sem ele, essas atribuições são recusadas com 401.
ADMIN_TOKEN=

# Origens permitidas no CORS, separadas por vírgula — padrão: http://localhost:3000
CORS_ORIGINS=
