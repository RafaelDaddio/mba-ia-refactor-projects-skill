# Variáveis de ambiente da aplicação.
# Elas são lidas do ambiente do processo (o projeto não carrega arquivo .env):
# defina-as no shell antes de rodar `python seed.py` e `python app.py`.

# Segredo que assina os tokens de login. Sem ele, a aplicação gera uma chave
# aleatória a cada inicialização e os tokens emitidos deixam de valer no reinício.
SECRET_KEY=

# Token administrativo aceito no header X-Admin-Token. Vazio = desabilitado.
ADMIN_TOKEN=

# Senha da conta administrativa criada pelo seed (joao@email.com).
# Sem ela, o seed cria a conta com uma senha aleatória.
SEED_ADMIN_PASSWORD=

# URI do banco. Padrão: sqlite:///tasks.db (arquivo instance/tasks.db na raiz do projeto).
DATABASE_URI=

# Servidor de desenvolvimento. Padrões: 127.0.0.1, 5000, debug desligado.
APP_HOST=
APP_PORT=
APP_DEBUG=

# Origens permitidas no CORS, separadas por vírgula. Padrão: http://localhost:3000
CORS_ORIGINS=
