# Variáveis de ambiente da aplicação.
# Elas são lidas do ambiente do processo (o projeto não carrega arquivos .env):
# defina-as no shell ou no serviço antes de rodar `python app.py`.
# Variável ausente ou vazia usa o padrão indicado.

# Servidor
APP_HOST=            # padrão: 127.0.0.1
APP_PORT=            # padrão: 5000
APP_DEBUG=           # padrão: false (nunca ligue em produção)

# Banco de dados SQLite; caminho relativo parte da raiz do projeto
DATABASE_PATH=       # padrão: loja.db
SEED_ON_START=       # padrão: true (insere os dados de exemplo nas tabelas vazias)

# Segredos (sem valor padrão no código)
SECRET_KEY=          # assina os tokens de login; sem ela, uma chave aleatória é gerada a cada início
ADMIN_TOKEN=         # enviado em X-Admin-Token nas rotas de administrador; sem ele, só contas "admin" acessam
SEED_ADMIN_PASSWORD= # senha de admin@loja.com no primeiro boot; sem ela, a conta nasce com senha aleatória

# Segurança
CORS_ORIGINS=        # origens permitidas, separadas por vírgula; padrão: nenhuma
ALLOW_ADMIN_SQL=     # padrão: false (POST /admin/query responde 403)
