# Variáveis de ambiente da API da Loja.
#
# Elas são lidas do ambiente do processo: a aplicação NÃO carrega um arquivo .env.
# Defina-as no shell antes de `python app.py`. Variável vazia vale como ausente.
# Este arquivo só documenta as variáveis; não coloque valores reais aqui.

# --- Segredos (sem valor padrão no código) ---------------------------------

# Segredo que assina os tokens de login. Sem ele, uma chave aleatória é gerada a
# cada inicialização e os tokens emitidos deixam de valer quando o processo reinicia.
SECRET_KEY=

# Token administrativo aceito no header `X-Admin-Token`. Sem ele, o header fica
# desabilitado e as rotas administrativas aceitam apenas contas com tipo "admin".
ADMIN_TOKEN=

# Senha da conta admin@loja.com criada pelo seed no primeiro boot. Sem ela, a conta
# é criada com uma senha aleatória (use o X-Admin-Token ou defina a variável antes
# de criar o banco).
SEED_ADMIN_PASSWORD=

# --- Servidor --------------------------------------------------------------

APP_HOST=127.0.0.1
APP_PORT=5000
# Modo debug do Flask (reloader e debugger). Nunca habilite fora de desenvolvimento.
APP_DEBUG=false

# --- Banco de dados --------------------------------------------------------

# Caminho do arquivo SQLite. Padrão: loja.db na raiz do projeto.
DATABASE_PATH=
# Insere os produtos e usuários de exemplo quando a tabela de produtos está vazia.
SEED_ON_START=true

# --- Segurança -------------------------------------------------------------

# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# Habilita POST /admin/query (execução de SQL recebido na requisição).
# Desligado por padrão: o endpoint responde 403 mesmo para administradores.
ALLOW_ADMIN_SQL=false
