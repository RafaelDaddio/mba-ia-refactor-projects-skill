# Variáveis lidas do ambiente do processo (este projeto não carrega arquivos .env).
# Variável definida mas vazia vale como ausente. Não coloque valores reais neste arquivo.

# Servidor
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false

# Banco SQLite; caminho relativo é resolvido a partir da raiz do projeto
DATABASE_PATH=loja.db

# Cria produtos e usuários de exemplo quando o banco está vazio (desligue fora do desenvolvimento)
SEED_ON_START=true
# Senha do usuário admin@loja.com criado pelo seed (sem ela, usa a senha de exemplo de desenvolvimento)
SEED_ADMIN_PASSWORD=

# Segredos: sem SECRET_KEY, uma chave aleatória temporária é gerada a cada inicialização
SECRET_KEY=

# Rotas /admin/* exigem o header X-Admin-Token com este valor; sem ele, ficam bloqueadas (401)
ADMIN_TOKEN=
# POST /admin/query (executa SQL recebido) só funciona com esta flag ligada; senão responde 403
ALLOW_ADMIN_SQL=false

# Origens permitidas para CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
